# Instalación con pnpm. Lo que importa aquí es la seguridad de la cadena de suministro.

# No ejecutar los scripts de ciclo de vida de las dependencias. Es el vector de los ataques de cadena de
# suministro en npm (un postinstall malicioso en un paquete transitivo). pnpm 10+ ya lo hace por defecto; se deja
# explícito para que no dependa de la versión. Si un paquete necesitara su script, se autoriza uno por uno en
# `onlyBuiltDependencies` de package.json.
enable-pre-post-scripts=false

# Fallar si el lockfile no cuadra con package.json, en vez de arreglarlo por su cuenta.
strict-peer-dependencies=false
resolution-mode=highest

# No instalar nada que se haya publicado hace menos de un día: la mayoría de los paquetes comprometidos se
# detectan y despublican en las primeras horas.
minimum-release-age=1440
