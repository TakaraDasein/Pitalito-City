{
  "name": "pitalito-city",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Mundo abierto web de Pitalito (Huila, Colombia) reconstruido con datos geográficos reales, recorrible en carro. three.js + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "pnpm data:fetch && pnpm data:google && pnpm data:rasters && pnpm data:build && pnpm refs:fetch && pnpm models:fetch",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:google": "node scripts/fetch-google-buildings.mjs",
    "data:rasters": "node scripts/fetch-rasters.mjs",
    "data:build": "node scripts/build-world.mjs",
    "refs:fetch": "node scripts/fetch-references.mjs",
    "models:fetch": "node scripts/fetch-characters.mjs",
    "shot": "node tools/screenshot.mjs",
    "shot:vehicle": "node tools/screenshot.mjs --vehicle",
    "bench": "node tools/bench.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "playwright-core": "^1.49.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:TakaraDasein/Pitalito-City.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.1"
}
